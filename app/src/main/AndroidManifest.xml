<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A live stream keeps playing with Matty minimised (plugins/villanet/StreamService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- A voice call keeps going with Matty minimised, its microphone included (plugins/villanet/VoiceService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Live streams and voice channels play audio through WebRTC; a voice call sets the call mode and its output. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Talking in voice channels. Asked for the first time somebody joins unmuted or unmutes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The unlock a server can ask for: the system's fingerprint, face or screen-lock prompt (ui/lock). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Matty never uses a camera: kept out whatever a library might ask for. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <!-- UnifiedPush (push/): the installed distributors, and their link activity. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="unifiedpush" android:host="link" />
        </intent>
    </queries>

    <application
        android:name=".MattyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Matty">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share text, images and files into a channel. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent WebSocket to the user's self-hosted Mattermost server, delivering messages without Google push" />
        </service>

        <service
            android:name=".plugins.villanet.StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Started as microphone and media playback when the microphone is allowed, media playback otherwise. -->
        <service
            android:name=".plugins.villanet.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false" />

        <!-- A UnifiedPush distributor is another app, so these two are exported. The receiver acts
             only on a token Matty made (push/PushGate); the service is an empty binder. -->
        <receiver
            android:name=".push.PushReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>
    </application>
</manifest>
